{
  "dependencies": {
    "@duckdb/node-api": "1.5.3-r.3",
    "geoparquet": "^0.5.0",
    "h3-js": "^4.4.0",
    "hyparquet-compressors": "^1.1.1",
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.8",
    "@electron/rebuild": "^3.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:gate": "node scripts/typecheck-gate.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host --port 4173",
    "build:browser": "vite build --mode browser",
    "build:desktop": "vite build --mode desktop",
    "rebuild:desktop": "electron-rebuild -f -w @duckdb/node-api",
    "run:desktop": "npm run build:desktop && npm exec electron ./electron/main.cjs"
  }
}
