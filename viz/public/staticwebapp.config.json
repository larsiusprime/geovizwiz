{
  "routes": [
    { "route": "/login", "serve": "/login.html" },
    { "route": "/login.html", "serve": "/login.html" },
    { "route": "/favicon.svg", "serve": "/favicon.svg" },
    { "route": "/logo.svg", "serve": "/logo.svg" },
    { "route": "/CLE-Logo.svg", "serve": "/CLE-Logo.svg" },
    { "route": "/CLE-logo.svg", "serve": "/CLE-Logo.svg" },
    { "route": "/cle-logo.svg", "serve": "/CLE-Logo.svg" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.svg",
      "/*.png",
      "/*.jpg",
      "/*.ico",
      "/*.json",
      "/login",
      "/login.html"
    ]
  }
}
